{
  "steps": [
    "welcome",
    "gacha-entry",
    "gacha-open",
    "album",
    "album-view",
    "deck",
    "deck-view",
    "deck-review",
    "battle-tab",
    "battle-view",
    "battle-result",
    "graduation"
  ],
  "scripts": {
    "welcome": {
      "advanceOn": "continue",
      "next": "gacha-entry",
      "lines": [
        {
          "mood": "idle",
          "text": "哟，新面孔。欢迎来到 Choke! —— 一个把 osu! 玩家做成卡牌的地方。"
        },
        {
          "mood": "happy",
          "text": "规则很简单：开包收卡 → 组一套卡组 → 上桌打一场。打不过也别慌，这里不掉 pp。"
        },
        {
          "mood": "smug",
          "text": "新手礼包已经塞进你背包了。先把第一包开了——手气这东西，越紧张越 choke。"
        }
      ]
    },

    "gacha-entry": {
      "target": { "desktop": "packs-entry", "book": "book-tab-packs" },
      "advanceOn": "click",
      "next": "gacha-open",
      "lines": [
        {
          "mood": "idle",
          "text": "看到桌上那个卡包展架了吗？点它，抽卡面板就会翻开。"
        },
        {
          "mood": "smug",
          "text": "放心，第一包算我的。开坏了也不扣 acc。"
        }
      ]
    },

    "gacha-open": {
      "target": {
        "desktop": "packs-entry",
        "book": ["gacha-open-button", "gacha-restock"]
      },
      "advanceOn": "event",
      "event": "pack-opened",
      "next": "album",
      "lines": [
        {
          "mood": "happy",
          "text": "点『开 {packSize} 张』。开出什么先别尖叫，卡册里都能找到。"
        },
        {
          "mood": "idle",
          "text": "如果出重复卡，别哭——重复卡能熔成经验。收藏家的第一课。"
        }
      ]
    },

    "album": {
      "target": { "desktop": "album-entry", "book": "book-tab-album" },
      "advanceOn": "click",
      "next": "album-view",
      "lines": [
        {
          "mood": "idle",
          "text": "抽完的卡已经进卡册了。走，去认认脸。"
        }
      ]
    },

    "album-view": {
      "target": "album-grid",
      "advanceOn": "continue",
      "next": "deck",
      "lines": [
        {
          "mood": "happy",
          "text": "这些就是你的第一批收藏。点卡面能看详情，拖到桌面还能摆着玩。"
        },
        {
          "mood": "smug",
          "text": "很好，Lv.2。卡组和对战垫已经解锁了，接下来该组一套能打的牌。"
        }
      ]
    },

    "deck": {
      "target": { "desktop": "deck-entry", "book": "book-tab-deck" },
      "advanceOn": "click",
      "next": "deck-view",
      "lines": [
        {
          "mood": "idle",
          "text": "点开卡组。右边是你的卡，左边是上阵的槽位。"
        },
        {
          "mood": "smug",
          "text": "新手别追求满编。教学战最多带 {lineupSize} 张，够用了。"
        }
      ]
    },

    "deck-view": {
      "target": { "desktop": "deck-entry", "book": "deck-tutorial-confirm" },
      "advanceOn": "event",
      "event": "deck-confirmed",
      "next": "deck-review",
      "lines": [
        {
          "mood": "idle",
          "text": "看到『按推荐一键上阵』了吗？点它，我按对手的脾气替你挑 {lineupSize} 张。"
        },
        {
          "mood": "happy",
          "text": "规矩是：每个职业先挑一张最强的，再看谁带着对口的属性。以后出征也是这套思路。"
        }
      ]
    },

    "deck-review": {
      "target": "deck-slots",
      "advanceOn": "continue",
      "next": "battle-tab",
      "lines": [
        {
          "mood": "happy",
          "text": "挑好了。每张卡为什么上场，我写在下面了，自己看一眼。"
        },
        {
          "mood": "smug",
          "text": "卡组不用完美，先上场挨打，才知道缺什么。"
        }
      ]
    },

    "battle-tab": {
      "target": "book-tab-battle",
      "advanceOn": "click",
      "next": "battle-view",
      "lines": [
        {
          "mood": "idle",
          "text": "现在翻到战斗页。对手是练习用的谱面幽灵，不会真的咬人。"
        }
      ]
    },

    "battle-view": {
      "target": {
        "desktop": "battle-entry",
        "book": ["battle-tutorial-start", "battle-go-deck"]
      },
      "advanceOn": "external",
      "next": "battle-result",
      "lines": [
        {
          "mood": "serious",
          "text": "点『进入教学对战』，会跳到真正的对战页。这一场我陪你打，输了也算我的。"
        },
        {
          "mood": "smug",
          "text": "教学战不计排名，掉不了你的 pp。放心按下去。"
        },
        {
          "mood": "idle",
          "text": "对了，这只幽灵身上藏着一个看不见的弱点——弱点条里那个『？』。用对的属性打中它一次，就会揭开。提示：幽灵怕火。"
        }
      ]
    },

    "battle-result": {
      "advanceOn": "continue",
      "next": "graduation",
      "lines": [
        {
          "mood": "happy",
          "text": "教学战结束！练习赛不计胜负，你已经完整走了一遍战斗流程。"
        },
        {
          "mood": "smug",
          "text": "Lv.3 达成。新手教程，毕业！"
        }
      ]
    },

    "graduation": {
      "advanceOn": "continue",
      "next": "done",
      "closeBookOnExit": true,
      "lines": [
        {
          "mood": "idle",
          "text": "背包、图鉴、邀请函现在都开放了。随便逛，别把卡册弄乱。"
        },
        {
          "mood": "serious",
          "text": "继续做任务、打对战升级，融合、远征会随等级陆续开放。市场要绑定 osu! 账号才能买卖，没绑的话只能看。"
        },
        {
          "mood": "happy",
          "text": "去吧。记得——别 choke。"
        }
      ]
    }
  },
  "character": {
    "name": "发牌员 · 阿圈",
    "title": "Choke! 发牌员"
  }
}
