{
  "steps": [
    "welcome",
    "gacha-entry",
    "gacha-open",
    "album",
    "album-detail",
    "card-train",
    "battle-tab",
    "battle-view",
    "battle-result",
    "expedition-entry",
    "graduation"
  ],
  "scripts": {
    "welcome": {
      "advanceOn": "continue",
      "next": "gacha-entry",
      "lines": [
        {
          "mood": "idle",
          "text": "哟，新面孔。欢迎来到 Choke! —— 一个把 osu! 玩家做成卡牌的地方。"
        },
        {
          "mood": "happy",
          "text": "这回我们把整套流程一次摸清：开包收卡 → 经验池养成与技能搭配 → 实战教学 → 远征出征。"
        },
        {
          "mood": "smug",
          "text": "新手礼包、300 点经验池和 200 金币已经备好了。先把第一包开了——手气这东西，越紧张越 choke。"
        }
      ]
    },

    "gacha-entry": {
      "target": { "desktop": "packs-entry", "book": "book-tab-packs" },
      "advanceOn": "click",
      "next": "gacha-open",
      "lines": [
        {
          "mood": "idle",
          "text": "看到桌上那个卡包展架了吗？点它，抽卡面板就会翻开。"
        },
        {
          "mood": "smug",
          "text": "放心，第一包算我的。开坏了也不扣 acc。"
        }
      ]
    },

    "gacha-open": {
      "target": {
        "desktop": "packs-entry",
        "book": ["gacha-open-button", "gacha-restock"]
      },
      "advanceOn": "event",
      "event": "pack-opened",
      "next": "album",
      "lines": [
        {
          "mood": "happy",
          "text": "点『开 {packSize} 张』。开出什么先别尖叫，卡册里都能找到。"
        },
        {
          "mood": "idle",
          "text": "记住每张卡都有职业和 2 个技能；重复卡以后可以分解或升命座。"
        }
      ]
    },

    "album": {
      "target": { "desktop": "album-entry", "book": "book-tab-album" },
      "advanceOn": "click",
      "next": "album-detail",
      "lines": [
        {
          "mood": "idle",
          "text": "抽完的卡已经进卡册了。去卡册点开一张卡看看它的面板和技能。"
        }
      ]
    },

    "album-detail": {
      "target": { "desktop": "album-entry", "book": ["album-first-card", "album-grid"] },
      "advanceOn": "event",
      "event": "card-detail-opened",
      "next": "card-train",
      "lines": [
        {
          "mood": "happy",
          "text": "点一下卡册里的任意一张卡，打开详情页。我们看看怎么养成和配技能。"
        }
      ]
    },

    "card-train": {
      "target": {
        "desktop": "album-entry",
        "book": ["card-detail-pool-alloc", "card-detail-upgrade", "card-detail-skills"]
      },
      "advanceOn": "event",
      "event": "card-upgraded",
      "next": "battle-tab",
      "lines": [
        {
          "mood": "idle",
          "text": "每张卡自带职业（坦克扛伤、战士/法师输出、辅助回血加攻）和 2 个技能；属性克制能快速破敌人的弱点盾。"
        },
        {
          "mood": "happy",
          "text": "下方『经验池』全队共享！点『补到下一级』或『升级』，用刚才发的 300 经验试着把这张卡升 1 级。"
        },
        {
          "mood": "smug",
          "text": "以后刷到不顺手的技能，也能在右侧技能栏消耗碎片和金币『洗技能』，每 5 次还有自选保底。"
        }
      ]
    },

    "battle-tab": {
      "target": { "desktop": "battle-entry", "book": "book-tab-battle" },
      "advanceOn": "click",
      "next": "battle-view",
      "lines": [
        {
          "mood": "idle",
          "text": "练好卡了，现在翻到战斗页。真正去打一场教学战，熟悉 AP、Combo、防御档位和弱点破盾。"
        }
      ]
    },

    "battle-view": {
      "target": {
        "desktop": "battle-entry",
        "book": ["battle-tutorial-start"]
      },
      "advanceOn": "external",
      "next": "battle-result",
      "lines": [
        {
          "mood": "serious",
          "text": "点『进入教学对战』，系统会自动替你挑最合适的前排上阵。战斗里顶部会有实时战术提示陪你打完。"
        },
        {
          "mood": "smug",
          "text": "记住：每回合看清敌方意图，有重击就抬高防御档位；用克制属性打中隐藏弱点『？』能直接破盾。"
        }
      ]
    },

    "battle-result": {
      "advanceOn": "continue",
      "next": "expedition-entry",
      "lines": [
        {
          "mood": "happy",
          "text": "教学战拿下！你已经摸清了出招、Combo、破盾和抬防的核心节奏。"
        },
        {
          "mood": "smug",
          "text": "现在 Lv.3 达成，全桌面功能与远征已经提前对你开放！"
        }
      ]
    },

    "expedition-entry": {
      "target": { "desktop": "battle-entry", "book": ["expedition-entry", "book-tab-battle"] },
      "advanceOn": "continue",
      "next": "graduation",
      "lines": [
        {
          "mood": "happy",
          "text": "真正的主玩法在『远征』里：选图 → 分配点数（上场卡槽 / AP 上限 / 稀有度权限）→ 挑卡出征，一路打节点拿经验池和奖励。"
        },
        {
          "mood": "idle",
          "text": "推荐毕业后直接点『进入远征』，从『序章 · 鼠标萌新与神秘 MP 房』开始你的第一次完整远征。"
        }
      ]
    },

    "graduation": {
      "advanceOn": "continue",
      "next": "done",
      "closeBookOnExit": true,
      "lines": [
        {
          "mood": "idle",
          "text": "背包、图鉴、分解、融合、任务和远征现在都已解锁。市场只要绑定 osu! 账号就能买卖。"
        },
        {
          "mood": "happy",
          "text": "去吧，祝你远征一路 Full Combo——别 choke。"
        }
      ]
    }
  },
  "character": {
    "name": "发牌员 · 阿圈",
    "title": "Choke! 发牌员"
  }
}
